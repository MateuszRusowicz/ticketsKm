{
  "name": "km",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "admin:create": "dotenv -e .env -- tsx scripts/create-admin.ts",
    "admin:reset-password": "dotenv -e .env -- tsx scripts/reset-admin-password.ts",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:seed:remote": "SEED_SKIP_ADMINS=1 dotenv -e .env.neon-dev -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force",
    "vercel-build": "prisma migrate deploy && prisma generate && next build",
    "holds:sweep": "dotenv -e .env -- tsx scripts/sweep-holds.ts",
    "holds:verify": "dotenv -e .env -- tsx scripts/verify-holds.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@stripe/react-stripe-js": "3.4.0",
    "@stripe/stripe-js": "5.7.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "stripe": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.2",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
