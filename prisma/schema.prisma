generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Venue {
  id              String   @id @default(uuid())
  name            String
  address         String
  city            String
  defaultCapacity Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
